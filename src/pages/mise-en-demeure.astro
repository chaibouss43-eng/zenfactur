---
import Base from '../layouts/Base.astro';
---
<Base
  title="Mise en demeure pour facture impayée : générez-la en 10 minutes"
  description="Générez une mise en demeure conforme (mentions légales, intérêts de retard, indemnité de 40 €) prête à envoyer en recommandé. 49 €, sans abonnement."
>
  <section class="hero" style="padding-bottom:1rem;">
    <span class="tampon">Lettre recommandée</span>
    <h1 style="margin-top:1rem;">Votre mise en demeure, conforme et prête à envoyer.</h1>
    <p class="sous-titre">
      Répondez aux questions ci-dessous. Vous obtenez une mise en demeure complète :
      rappel des faits, fondement légal, intérêts de retard au taux légal, indemnité
      forfaitaire de 40&nbsp;€, délai de paiement. Prête à imprimer et envoyer en
      recommandé avec accusé de réception.
    </p>
  </section>

  <div class="split-2">
    <div class="reassurance" style="grid-template-columns:1fr;">
      <div class="item">Aperçu gratuit avant tout paiement — vous voyez la lettre avant de payer</div>
      <div class="item">Fondements légaux adaptés : client professionnel (Code de commerce) ou particulier (Code civil)</div>
      <div class="item">Intérêts de retard et indemnité forfaitaire de 40 € intégrés</div>
      <div class="item">Paiement unique de 49 € — pas d'abonnement, pas de compte à créer</div>
      <div class="item">Vos données restent dans votre navigateur, rien n'est stocké</div>
    </div>
    <div style="display:flex; justify-content:center;">
      <div class="mockup-lettre" aria-hidden="true">
        <div class="ml-titre">MISE EN DEMEURE — facture n° 2026-042</div>
        <div class="ml-ligne courte"></div>
        <div class="ml-ligne"></div>
        <div class="ml-ligne"></div>
        <div class="ml-ligne courte"></div>
        <div class="ml-ligne"></div>
        <div class="ml-ligne"></div>
        <div class="ml-ligne courte"></div>
        <span class="tampon">Recommandé AR</span>
      </div>
    </div>
  </div>

  <div class="encadre">
    <strong>Pourquoi une mise en demeure ?</strong> C'est le préalable obligatoire avant
    toute action en justice (injonction de payer) et elle fait courir officiellement les
    intérêts de retard. Dans la majorité des cas, elle suffit à débloquer le paiement.
  </div>

  <form class="formulaire" id="form-md">
    <fieldset>
      <legend>1. Vous (le créancier)</legend>
      <div class="grille-2">
        <div class="champ">
          <label for="c-nom">Nom / raison sociale</label>
          <input id="c-nom" name="c-nom" required autocomplete="organization" />
        </div>
        <div class="champ">
          <label for="c-siret">SIRET</label>
          <input id="c-siret" name="c-siret" inputmode="numeric" required />
        </div>
      </div>
      <div class="champ">
        <label for="c-adresse">Adresse complète</label>
        <input id="c-adresse" name="c-adresse" required autocomplete="street-address" />
      </div>
    </fieldset>

    <fieldset>
      <legend>2. Votre client (le débiteur)</legend>
      <div class="grille-2">
        <div class="champ">
          <label for="d-nom">Nom / raison sociale</label>
          <input id="d-nom" name="d-nom" required />
        </div>
        <div class="champ">
          <label for="d-type">Type de client</label>
          <select id="d-type" name="d-type">
            <option value="pro">Professionnel (B2B)</option>
            <option value="particulier">Particulier (B2C)</option>
          </select>
        </div>
      </div>
      <div class="champ">
        <label for="d-adresse">Adresse complète</label>
        <input id="d-adresse" name="d-adresse" required />
      </div>
    </fieldset>

    <fieldset>
      <legend>3. La facture impayée</legend>
      <div class="grille-2">
        <div class="champ">
          <label for="f-num">Numéro de facture</label>
          <input id="f-num" name="f-num" required />
        </div>
        <div class="champ">
          <label for="f-montant">Montant TTC (€)</label>
          <input id="f-montant" name="f-montant" type="number" step="0.01" min="0" required />
        </div>
        <div class="champ">
          <label for="f-date">Date de la facture</label>
          <input id="f-date" name="f-date" type="date" required />
        </div>
        <div class="champ">
          <label for="f-echeance">Date d'échéance</label>
          <input id="f-echeance" name="f-echeance" type="date" required />
        </div>
      </div>
      <div class="champ">
        <label for="f-objet">Objet de la prestation (une phrase)</label>
        <input id="f-objet" name="f-objet" placeholder="Ex. : travaux de plomberie réalisés au 12 rue…" required />
      </div>
    </fieldset>

    <fieldset>
      <legend>4. Relances déjà effectuées (optionnel)</legend>
      <div class="champ">
        <label for="relances">Décrivez brièvement (dates des emails, appels…)</label>
        <textarea id="relances" name="relances" rows="2"></textarea>
      </div>
    </fieldset>

    <!--
      FLUX DE PAIEMENT (Stripe Payment Link, aucun backend) :
      1. Le bouton "Aperçu gratuit" génère un aperçu filigrané dans la page.
      2. Le bouton "Obtenir ma lettre" sauvegarde le formulaire en sessionStorage
         puis redirige vers le Payment Link Stripe.
      3. Configurer le Payment Link avec une redirection post-paiement vers
         /mise-en-demeure-telechargement/ qui régénère le PDF final sans filigrane.
      REMPLACER l'URL ci-dessous par votre vrai Payment Link Stripe.
    -->
    <div style="display:flex; gap:1rem; flex-wrap:wrap;">
      <button type="button" class="btn btn--ghost" id="btn-apercu">Aperçu gratuit</button>
      <button type="button" class="btn btn--tampon" id="btn-payer">Obtenir ma lettre — 49&nbsp;€</button>
    </div>
    <p style="font-size:.85rem; color:var(--grise); margin-top:.75rem;">
      Paiement sécurisé par Stripe. Document livré immédiatement en PDF. Pas d'abonnement, pas de compte à créer.
    </p>
  </form>

  <div id="apercu-bloc" style="display:none; margin-block:2rem;">
    <h2 style="margin-top:0;">Votre lettre — aperçu</h2>
    <iframe id="apercu-pdf" title="Aperçu de votre mise en demeure" style="width:100%; height:75vh; border:1px solid var(--ligne); border-radius:10px; background:#fff;"></iframe>
    <p style="font-size:.85rem; color:var(--grise); margin-top:.5rem;">
      L'aperçu ne s'affiche pas ? <a id="apercu-lien" href="#" target="_blank" rel="noopener">Ouvrir l'aperçu dans un nouvel onglet</a>.
    </p>
    <div class="encadre" style="display:flex; flex-wrap:wrap; gap:1rem; align-items:center; justify-content:space-between; border-left-color:var(--valide);">
      <div style="flex:1; min-width:240px;">
        <strong>✓ Ceci est votre lettre.</strong><br/>
        La version finale est livrée <strong>sans filigrane</strong>, accompagnée de la
        <strong>page 2 « Mode d'emploi »</strong> : envoi, délais, checklist du dossier de preuve
        et marche à suivre jusqu'à l'injonction de payer.
      </div>
      <button type="button" class="btn btn--tampon" id="btn-payer-2">Obtenir ma lettre — 49&nbsp;€</button>
    </div>
  </div>

  <section class="prose">
    <h2>Questions fréquentes</h2>
    <h3>Est-ce que cette lettre a une valeur juridique ?</h3>
    <p>Oui. Une mise en demeure n'a pas besoin d'être rédigée par un avocat pour être
    valable : elle doit contenir certaines mentions (identités, créance précise,
    demande expresse de payer, délai) et être envoyée en recommandé avec AR. La lettre
    générée contient toutes ces mentions.</p>
    <h3>Et si mon client ne paie toujours pas ?</h3>
    <p>La mise en demeure est le préalable à l'injonction de payer, une procédure
    judiciaire simple et peu coûteuse. Notre guide vous explique la suite.</p>
  </section>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script>
    const $ = (id) => document.getElementById(id);
    const val = (id) => ($(id) && 'value' in $(id) ? $(id).value.trim() : '');
    const collecter = () => {
      const donnees = {};
      new FormData(document.getElementById('form-md')).forEach((v, k) => (donnees[k] = v));
      return donnees;
    };

    // ===== Générateur PDF — page 1 (identique à la version finale) =====
    function genererPage1(d, apercu) {
      const BLEU = [0, 0, 145], ROUGE = [193, 18, 31], GRIS = [107, 107, 112], NOIR = [22, 22, 29];
      const M = 20, W = 210 - 2 * M;
      const TAUX_PENALITES = 12.35; // BCE + 10 pts — à actualiser chaque semestre
      const frDate = (iso) => { const p = (iso || '').split('-'); return p.length === 3 ? `${p[2]}/${p[1]}/${p[0]}` : iso; };
      const eur = (n) => n.toFixed(2).replace('.', ',') + ' \u20AC';
      const montant = parseFloat(d['f-montant'] || '0');
      const estPro = d['d-type'] === 'pro';
      const auj = new Date();
      const dateJour = auj.toLocaleDateString('fr-FR');
      const ech = new Date(d['f-echeance']);
      const joursRetard = Math.max(0, Math.floor((auj - ech) / 86400000));
      const penalites = estPro ? montant * (TAUX_PENALITES / 100) * (joursRetard / 365) : 0;
      const indemnite = estPro ? 40 : 0;
      const total = montant + penalites + indemnite;

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ unit: 'mm', format: 'a4' });

      doc.setFillColor(...BLEU); doc.rect(0, 0, 210, 26, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFont('helvetica', 'bold'); doc.setFontSize(17);
      doc.text('MISE EN DEMEURE', M, 12);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
      doc.text('Avant poursuites \u2014 article 1344 du Code civil', M, 18.5);
      doc.text(`R\u00e9f. : facture n\u00b0 ${d['f-num']}`, 210 - M, 11, { align: 'right' });
      doc.text(`Le ${dateJour}`, 210 - M, 16.5, { align: 'right' });
      doc.setTextColor(...NOIR);

      let y = 36;
      doc.setFontSize(8); doc.setTextColor(...GRIS); doc.setFont('helvetica', 'bold');
      doc.text('EXP\u00c9DITEUR (CR\u00c9ANCIER)', M, y);
      doc.setTextColor(...NOIR); doc.setFontSize(10);
      doc.text(d['c-nom'], M, y + 5.5);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
      doc.text(doc.splitTextToSize(d['c-adresse'], 82), M, y + 10.5);
      doc.text(`SIRET : ${d['c-siret']}`, M, y + 20);

      doc.setDrawColor(...NOIR); doc.setLineWidth(0.35);
      doc.rect(115, y - 4, 75, 27);
      doc.setFontSize(8); doc.setTextColor(...GRIS); doc.setFont('helvetica', 'bold');
      doc.text('DESTINATAIRE (D\u00c9BITEUR)', 118, y);
      doc.setTextColor(...NOIR); doc.setFontSize(10);
      doc.text(d['d-nom'], 118, y + 5.5);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9.5);
      doc.text(doc.splitTextToSize(d['d-adresse'], 69), 118, y + 10.5);

      y = 70;
      doc.setDrawColor(...ROUGE); doc.setLineWidth(0.6);
      doc.setTextColor(...ROUGE); doc.setFont('helvetica', 'bold'); doc.setFontSize(10);
      const mention = 'LETTRE RECOMMAND\u00c9E AVEC ACCUS\u00c9 DE R\u00c9CEPTION';
      doc.rect(M, y - 5.5, doc.getTextWidth(mention) + 8, 8);
      doc.text(mention, M + 4, y);
      doc.setTextColor(...NOIR);

      y = 82;
      const para = (txt, opts = {}) => {
        doc.setFont('helvetica', opts.gras ? 'bold' : 'normal');
        doc.setFontSize(opts.taille || 10);
        const lignes = doc.splitTextToSize(txt, W);
        doc.text(lignes, M, y);
        y += lignes.length * 4.6 + (opts.apres ?? 3);
      };

      para('Madame, Monsieur,');
      para(`Sauf erreur de notre part, la facture n\u00b0 ${d['f-num']} \u00e9mise le ${frDate(d['f-date'])}, d'un montant de ${eur(montant)} TTC, relative \u00e0 ${d['f-objet']}, demeure impay\u00e9e \u00e0 ce jour malgr\u00e9 son \u00e9ch\u00e9ance fix\u00e9e au ${frDate(d['f-echeance'])} \u2014 soit ${joursRetard} jours de retard.`);
      if (d['relances']) para(`Cette situation persiste malgr\u00e9 nos relances : ${d['relances']}.`);
      para(`En cons\u00e9quence, nous vous mettons en demeure de proc\u00e9der au r\u00e8glement int\u00e9gral des sommes dues, dont le d\u00e9compte figure ci-dessous, sous huit (8) jours \u00e0 compter de la r\u00e9ception de la pr\u00e9sente.`, { gras: true });

      y += 1;
      doc.setFont('helvetica', 'bold'); doc.setFontSize(9); doc.setTextColor(...BLEU);
      doc.text(`D\u00c9COMPTE DE LA CR\u00c9ANCE AU ${dateJour}`, M, y);
      doc.setTextColor(...NOIR);
      y += 3;
      const row = (lib, valTxt, opts = {}) => {
        const h = 7.5;
        if (opts.total) { doc.setFillColor(...BLEU); doc.rect(M, y, W, h, 'F'); doc.setTextColor(255, 255, 255); }
        else { doc.setDrawColor(210, 210, 215); doc.setLineWidth(0.25); doc.rect(M, y, W, h); }
        doc.setFont('helvetica', opts.total ? 'bold' : 'normal'); doc.setFontSize(9.5);
        doc.text(lib, M + 3, y + 5);
        doc.setFont('helvetica', 'bold');
        doc.text(valTxt, 210 - M - 3, y + 5, { align: 'right' });
        if (opts.total) doc.setTextColor(...NOIR);
        y += h;
      };
      row(`Principal \u2014 facture n\u00b0 ${d['f-num']}`, eur(montant));
      if (estPro) {
        row(`P\u00e9nalit\u00e9s de retard (${joursRetard} j. au taux de ${TAUX_PENALITES.toFixed(2).replace('.', ',')} %/an \u2014 art. L441-10 C. com.)`, eur(penalites));
        row(`Indemnit\u00e9 forfaitaire de recouvrement (art. D441-5 C. com.)`, eur(indemnite));
      }
      row('TOTAL EXIGIBLE', eur(total), { total: true });
      if (estPro) {
        doc.setFont('helvetica', 'italic'); doc.setFontSize(7.5); doc.setTextColor(...GRIS);
        y += 4;
        doc.text("P\u00e9nalit\u00e9s arr\u00eat\u00e9es \u00e0 la date de la pr\u00e9sente et continuant de courir jusqu'au complet paiement. Taux applicable sauf stipulation contraire des CGV.", M, y);
        doc.setTextColor(...NOIR);
        y += 7;
      } else { y += 5; }

      para(estPro
        ? `Nous vous rappelons qu'en application de l'article L441-10 du Code de commerce, les p\u00e9nalit\u00e9s de retard sont exigibles de plein droit, sans qu'un rappel soit n\u00e9cessaire, de m\u00eame que l'indemnit\u00e9 forfaitaire de recouvrement de 40 \u20AC pr\u00e9vue \u00e0 l'article D441-5 du m\u00eame code.`
        : `Conform\u00e9ment \u00e0 l'article 1344-1 du Code civil, la pr\u00e9sente mise en demeure fait courir les int\u00e9r\u00eats au taux l\u00e9gal sur les sommes dues.`);
      para(`\u00c0 d\u00e9faut de r\u00e8glement int\u00e9gral dans le d\u00e9lai imparti, nous saisirons sans autre avis la juridiction comp\u00e9tente, notamment par voie d'injonction de payer, l'ensemble des frais de recouvrement \u00e9tant alors \u00e0 votre charge dans les conditions pr\u00e9vues par la loi.`);
      para(`Le r\u00e8glement peut \u00eatre effectu\u00e9 par virement ou par ch\u00e8que \u00e0 l'ordre de ${d['c-nom']}. Nous restons joignables pour convenir, le cas \u00e9ch\u00e9ant, de modalit\u00e9s de paiement.`);
      para('Veuillez agr\u00e9er, Madame, Monsieur, nos salutations distingu\u00e9es.', { apres: 10 });

      doc.setFont('helvetica', 'bold'); doc.setFontSize(10);
      doc.text(d['c-nom'], 210 - M, y, { align: 'right' });
      y += 5;
      doc.setFont('helvetica', 'normal'); doc.setFontSize(9); doc.setTextColor(...GRIS);
      doc.text('Signature :', 210 - M - 45, y + 4);
      doc.setTextColor(...NOIR);

      // Pied de page
      doc.setDrawColor(...GRIS); doc.setLineWidth(0.2);
      doc.line(M, 285, 210 - M, 285);
      doc.setFont('helvetica', 'normal'); doc.setFontSize(7.5); doc.setTextColor(...GRIS);
      doc.text(`Document g\u00e9n\u00e9r\u00e9 le ${dateJour} via zenfactur.fr`, M, 290);
      doc.setTextColor(...NOIR);

      if (apercu) {
        doc.saveGraphicsState();
        doc.setGState(new doc.GState({ opacity: 0.13 }));
        doc.setTextColor(193, 18, 31);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(44);
        for (let yy = 70; yy <= 280; yy += 85) {
          doc.text('APER\u00c7U \u2014 NON VALABLE', 105, yy, { align: 'center', angle: 35 });
        }
        doc.restoreGraphicsState();
      }
      return doc;
    }

    let apercuUrl = null;
    $('btn-apercu').addEventListener('click', () => {
      if (!document.getElementById('form-md').reportValidity()) return;
      const doc = genererPage1(collecter(), true);
      const blob = doc.output('blob');
      if (apercuUrl) URL.revokeObjectURL(apercuUrl);
      apercuUrl = URL.createObjectURL(blob);
      $('apercu-pdf').src = apercuUrl;
      $('apercu-lien').href = apercuUrl;
      $('apercu-bloc').style.display = 'block';
      $('apercu-bloc').scrollIntoView({ behavior: 'smooth' });
    });

    const payer = () => {
      if (!document.getElementById('form-md').reportValidity()) return;
      sessionStorage.setItem('zenfactur-md', JSON.stringify(collecter()));
      window.location.href = 'https://buy.stripe.com/aFa5kv44g1RV2w224ieZ200';
    };
    $('btn-payer').addEventListener('click', payer);
    document.addEventListener('click', (e) => { if (e.target && e.target.id === 'btn-payer-2') payer(); });
  </script>
</Base>
