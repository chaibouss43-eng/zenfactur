---
import Base from '../../layouts/Base.astro';
---
<Base title="Outils gratuits pour artisans et TPE" description="Calculateurs et vérificateurs gratuits : intérêts de retard, mentions obligatoires de facture.">
  <section class="hero" style="padding-bottom:1rem;">
    <h1>Outils gratuits</h1>
    <p class="sous-titre">Sans inscription, sans email demandé.</p>
  </section>
  <div class="grille-cartes">
    <div class="carte">
      <a href="/outils/generateur-relance/">
        <span class="tampon tampon--vert">Gratuit</span>
        <h3>Générateur d'email de relance</h3>
        <p class="meta">3 tons au choix : amiable, ferme, dernier avertissement.</p>
      </a>
    </div>
    <div class="carte">
      <a href="/outils/calculateur-interets-retard/">
        <span class="tampon tampon--vert">Gratuit</span>
        <h3>Calculateur d'intérêts de retard</h3>
        <p class="meta">Pénalités + indemnité de 40 € sur une facture impayée.</p>
      </a>
    </div>
  </div>
</Base>
