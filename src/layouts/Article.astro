---
import Base from './Base.astro';
const { frontmatter, minutes, aLire = [] } = Astro.props;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: frontmatter.title,
  description: frontmatter.description,
  datePublished: frontmatter.pubDate,
  inLanguage: "fr-FR",
};
const estImpayes = frontmatter.theme === 'impayes';
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="progress-lecture" id="progress"></div>

  <nav class="ariane" aria-label="Fil d'ariane">
    <a href="/">Accueil</a> › <a href="/guides/">Guides</a> › {estImpayes ? 'Impayés' : 'Facturation électronique'}
  </nav>

  <article class="prose" style="margin-top:1rem;">
    <span class={`tampon ${estImpayes ? '' : 'tampon--bleu'}`}>
      {estImpayes ? 'Impayés' : 'Facturation électronique'}
    </span>
    <h1 style="margin-top:1rem;">{frontmatter.title}</h1>
    <p class="meta" style="color:var(--grise);font-size:.9rem;">
      Mis à jour le {new Date(frontmatter.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
      {minutes && <span class="temps-lecture"> · ⏱ {minutes} min de lecture</span>}
    </p>
    {frontmatter.affiliation && (
      <p class="mention-affiliation">Cet article contient des liens d'affiliation, signalés comme tels.
      Ils ne modifient pas le prix et n'influencent pas nos avis.</p>
    )}
    <slot />

    {aLire.length > 0 && (
      <div class="a-lire">
        <h2>À lire ensuite</h2>
        <div class="grille-cartes">
          {aLire.map((g) => (
            <div class="carte">
              <a href={`/guides/${g.id}/`}>
                <span class={`tampon ${g.data.theme === 'impayes' ? '' : 'tampon--bleu'}`} style="font-size:.65rem;">
                  {g.data.theme === 'impayes' ? 'Impayés' : 'E-facture'}
                </span>
                <h3 style="font-size:1rem;">{g.data.title}</h3>
              </a>
            </div>
          ))}
        </div>
      </div>
    )}
  </article>

  <div class="cta-flottant" id="cta-flottant">
    {estImpayes ? (
      <>
        <p>Client qui ne paie pas ? Votre lettre conforme en 10 minutes.</p>
        <a class="btn btn--tampon" href="/mise-en-demeure/">Créer ma mise en demeure — 49&nbsp;€</a>
      </>
    ) : (
      <>
        <p>Pas encore conforme ? Les logiciels gratuits qui règlent tout.</p>
        <a class="btn btn--primaire" href="/comparatif/logiciel-facturation-gratuit/">Voir le comparatif gratuit</a>
      </>
    )}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <script>
    const bar = document.getElementById('progress');
    const cta = document.getElementById('cta-flottant');
    addEventListener('scroll', () => {
      const h = document.documentElement;
      const pct = h.scrollTop / (h.scrollHeight - h.clientHeight);
      bar.style.width = (pct * 100) + '%';
      cta.classList.toggle('visible', pct > 0.25 && pct < 0.95);
    }, { passive: true });
  </script>
</Base>
